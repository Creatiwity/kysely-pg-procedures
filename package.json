{
  "name": "kysely-pg-procedures",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:procedures:watch": "node --experimental-strip-types src/watch.ts"
  },
  "dependencies": {
    "kysely": "^0.28.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "chokidar": "^4.0.0",
    "pg": "^8.13.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
