{
  "name": "kysely-pg-procedures",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:procedures:watch": "node --experimental-strip-types src/watch.ts",
    "playground": "tsx playground/index.ts",
    "proc:status": "tsx src/cli/index.ts status",
    "proc:generate": "tsx src/cli/index.ts generate",
    "proc:manifest-rebuild": "tsx src/cli/index.ts manifest-rebuild"
  },
  "dependencies": {
    "kysely": "^0.28.5"
  },
  "peerDependencies": {
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "chokidar": "^4.0.0",
    "pg": "^8.13.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
